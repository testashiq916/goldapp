<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ $siteName }} - User {{ strtoupper($userName) }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
/* ═══════════════════════════════════════════════
   DESIGN SYSTEM — NiceAdmin Professional Theme
═══════════════════════════════════════════════ */
:root {
    --bg: #faf9fd;
    --bg2: #efedf2;
    --surface: #ffffff;
    --surface2: #f7f7fa;
    --surface3: #ecedf2;
    --border: #e0e6eb;
    --border2: #c4c6d0;
    --gold: #005cbb;
    --gold2: #1a6fd0;
    --gold3: #abc7ff;
    --gold-glow: rgba(0,92,187,0.07);
    --emerald: #70c748;
    --ruby: #ef4444;
    --sapphire: #8754ec;
    --text: #1a1b1f;
    --text2: #565e71;
    --text3: #74777f;
    --r: 12px;
    --r-sm: 8px;
    --shadow-lg: 0 12px 24px -4px rgba(145,158,171,0.12), 0 0 2px rgba(145,158,171,0.30);
    --shadow-md: 0 4px 12px rgba(145,158,171,0.10), 0 0 2px rgba(145,158,171,0.20);
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
    color: var(--text);
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
    font-size: 13px;
}

/* Scrollbar */
::-webkit-scrollbar { width: 7px; height: 7px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #a0a4b0; }

.app {
    display: grid;
    grid-template-rows: 36px 38px 42px 1fr 30px;
    height: 100vh;
}

/* ════════════════════════════════════════
   TOP BAR (row 1)
════════════════════════════════════════ */
.top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    color: var(--text);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 4px rgba(145,158,171,0.14);
    z-index: 2300;
}

.top-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
}

.company-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--gold2);
    letter-spacing: 0.2px;
}

.company-title i { color: var(--gold2); }

.gold-rate { display: none; }

.top-right {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
}

.demo {
    background: var(--gold-glow);
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid rgba(0,92,187,0.25);
    letter-spacing: 0.5px;
}

.user-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--surface2);
    border: 1px solid var(--border);
    user-select: none;
    color: var(--text2);
    font-size: 12px;
    transition: all 0.15s;
}

.user-chip:hover {
    background: var(--surface3);
    color: var(--text);
    border-color: var(--border2);
}

.user-menu {
    position: absolute;
    right: 0;
    top: 36px;
    min-width: 180px;
    background: var(--surface2);
    color: var(--text);
    border: 1px solid var(--border2);
    box-shadow: var(--shadow-lg);
    border-radius: var(--r-sm);
    display: none;
    z-index: 3000;
}

.user-menu.show { display: block; }

.user-menu a,
.user-menu button {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    background: transparent;
    padding: 8px 12px;
    cursor: pointer;
    color: var(--text2);
    text-decoration: none;
    font-size: 12.5px;
    transition: all 0.1s;
}

.user-menu a:hover,
.user-menu button:hover {
    background: var(--surface3);
    color: var(--text);
}

/* ════════════════════════════════════════
   MENU BAR (row 2, built by JS)
════════════════════════════════════════ */
.menu-bar {
    display: flex;
    align-items: center;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 6px;
    gap: 2px;
    overflow: visible;
    position: relative;
    z-index: 2200;
}

.menu-item {
    position: relative;
    font-size: 12.5px;
    font-weight: 500;
    padding: 0 12px;
    height: 100%;
    display: flex;
    align-items: center;
    cursor: pointer;
    white-space: nowrap;
    color: var(--text2);
    border-radius: 4px;
    margin: 4px 1px;
    transition: color 0.12s, background 0.12s;
    user-select: none;
}

.menu-item:hover,
.menu-item.active {
    color: var(--text);
    background: var(--surface2);
}

.menu-item::after {
    content: "";
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
}

.menu-item:hover::after,
.menu-item.active::after {
    transform: scaleX(1);
}

.dropdown,
.submenu {
    position: absolute;
    background: var(--surface2);
    border: 1px solid var(--border2);
    box-shadow: var(--shadow-lg);
    border-radius: var(--r-sm);
    min-width: 240px;
    max-height: none;
    overflow: visible;
    z-index: 2500;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px) scale(0.98);
    transform-origin: top left;
    transition: none;
    padding: 4px;
}

.dropdown { top: 100%; left: 0; }
.submenu {
    top: -1px;
    left: 100%;
    transform: translateX(6px) scale(0.98);
    transform-origin: top left;
}

.dropdown.registration-menu {
    min-width: 560px;
    display: grid;
    grid-template-columns: repeat(2, minmax(250px, 1fr));
    gap: 2px 8px;
    padding: 6px;
}

.dropdown.show,
.submenu.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(0, 0) scale(1);
}

.dd-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px;
    font-size: 12.5px;
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    color: var(--text2);
    transition: all 0.1s;
}

.dd-item:hover {
    background: var(--surface3);
    color: var(--text);
}

.dd-item:hover > .submenu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0) scale(1);
}

.dd-left {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 1;
}

.dd-left i {
    width: 14px;
    text-align: center;
    font-size: 11px;
    color: var(--gold);
    flex-shrink: 0;
    transition: color 0.16s ease;
}

.dd-item:hover .dd-left i {
    color: var(--gold2);
}

.key {
    font-size: 10px;
    color: var(--text3);
    background: var(--surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
    white-space: nowrap;
    margin-left: 8px;
}

.dd-divider {
    height: 1px;
    background: var(--border);
    margin: 3px 0;
}

/* ════════════════════════════════════════
   TOOLBAR (row 3)
════════════════════════════════════════ */
.toolbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
}

.tb-btn {
    height: 30px;
    min-width: 28px;
    padding: 0 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--text2);
    cursor: pointer;
    font-size: 11.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s;
    white-space: nowrap;
    font-family: inherit;
    font-weight: 500;
}

.tb-btn:hover {
    background: var(--gold-glow);
    color: var(--gold);
    border-color: var(--gold2);
    box-shadow: 0 2px 8px rgba(0,92,187,0.10);
}

.tb-btn.active, .tb-btn.gold {
    color: var(--gold);
    border-color: rgba(0,92,187,0.30);
    background: var(--gold-glow);
}

.tb-btn i { font-size: 12px; }

.tb-kbd {
    display: inline-flex;
    align-items: center;
    font-size: 9px;
    padding: 1px 5px;
    background: var(--surface3);
    border-radius: 4px;
    color: var(--text3);
    font-weight: 600;
    letter-spacing: 0.3px;
    margin-left: 2px;
}

.tb-sep {
    width: 1px;
    height: 20px;
    background: var(--border);
    margin: 0 4px;
    flex-shrink: 0;
}


/* ════════════════════════════════════════
   CONTENT / MDI AREA (row 4)
════════════════════════════════════════ */
.content {
    min-height: 0;
    display: block;
    height: 100%;
}

.mdi {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    height: 100%;
}

/* Grid dots background */
.mdi::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, var(--border) 0.8px, transparent 0.8px);
    background-size: 32px 32px;
    opacity: 0.35;
}

/* ════════════════════════════════════════
   LOGO / ANALYTICS SCREEN
════════════════════════════════════════ */
.logo-screen {
    position: absolute;
    inset: 0;
    padding: 0;
    background: var(--bg);
    overflow: auto;
}

.home-head {
    color: var(--gold2);
    margin-bottom: 14px;
}

.home-head h1 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.home-head p {
    color: var(--text2);
    font-size: 13px;
}

/* ── Summary Cards (top row with icons) ── */
.summary-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 16px;
}
.summary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.2s, transform 0.2s;
}
.summary-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
}
.summary-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.summary-icon.blue   { background: #e8f0fe; color: #1a73e8; }
.summary-icon.orange { background: #fef3e2; color: #e8710a; }
.summary-icon.coral  { background: #fde8e8; color: #e53935; }
.summary-icon.green  { background: #e6f4ea; color: #1e8e3e; }
.summary-count {
    font-size: 22px; font-weight: 700;
    font-family: 'Playfair Display', serif;
    color: var(--text);
    line-height: 1.1;
}
.summary-label {
    font-size: 11.5px; color: var(--text3);
    margin-top: 2px;
}

/* ── Rate Cards ── */
.rate-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 16px;
}
.rate-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 14px 16px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.2s, transform 0.2s;
}
.rate-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
}
.rate-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 100%;
}
.rate-card.gold::before   { background: linear-gradient(180deg, #d4a017, #f5c842); }
.rate-card.gold18::before { background: linear-gradient(180deg, #c77700, #e8a030); }
.rate-card.silver::before { background: linear-gradient(180deg, #78909c, #b0bec5); }
.rate-card.th::before     { background: linear-gradient(180deg, #7b1fa2, #ab47bc); }
.rate-card-label {
    font-size: 10.5px; color: var(--text3); text-transform: uppercase;
    letter-spacing: 0.8px; font-weight: 600; margin-bottom: 4px;
    display: flex; align-items: center; gap: 6px;
}
.rate-card-label i { font-size: 11px; }
.rate-card-value {
    font-size: 22px; font-weight: 700;
    font-family: 'Playfair Display', serif;
    letter-spacing: -0.3px;
}
.rate-card.gold .rate-card-value   { color: #b8860b; }
.rate-card.gold18 .rate-card-value { color: #c77700; }
.rate-card.silver .rate-card-value { color: #546e7a; }
.rate-card.th .rate-card-value     { color: #7b1fa2; }
.rate-card-sub { font-size: 10.5px; color: var(--text3); margin-top: 2px; }

/* ── KPI Cards ── */
.kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(160px, 1fr));
    gap: 14px;
    margin-bottom: 16px;
}
.kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 16px 18px;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.2s, transform 0.2s;
    position: relative;
}
.kpi-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
}
.kpi-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 8px;
}
.kpi-title {
    font-size: 11px; color: var(--text3); text-transform: uppercase;
    letter-spacing: 0.7px; font-weight: 600;
}
.kpi-icon {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
}
.kpi-icon.blue   { background: #e8f0fe; color: #1a73e8; }
.kpi-icon.green  { background: #e6f4ea; color: #1e8e3e; }
.kpi-icon.orange { background: #fef3e2; color: #e8710a; }
.kpi-icon.purple { background: #f3e8fd; color: #7b1fa2; }
.kpi-value {
    font-size: 22px; font-weight: 700;
    font-family: 'Playfair Display', serif;
    color: var(--text); line-height: 1.2;
}
.kpi-footer {
    display: flex; align-items: center; gap: 8px; margin-top: 6px;
}
.kpi-trend {
    font-size: 11px; font-weight: 600; padding: 2px 6px;
    border-radius: 4px; display: inline-flex; align-items: center; gap: 3px;
}
.kpi-trend.up   { background: #e6f4ea; color: #1e8e3e; }
.kpi-trend.down { background: #fde8e8; color: #e53935; }
.kpi-sub {
    font-size: 11px; color: var(--text3);
}

/* ── Analytics Grid ── */
.analytics-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 14px;
}
.panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 18px;
    box-shadow: var(--shadow-md);
}
.panel-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 12px;
}
.panel-head h3 {
    font-size: 14px; color: var(--text); font-weight: 600;
    display: flex; align-items: center; gap: 8px;
}
.panel-head h3 i { font-size: 14px; color: var(--gold2); }
.panel-badge {
    font-size: 10px; padding: 3px 10px; border-radius: 12px;
    background: var(--surface3); color: var(--text2); font-weight: 600;
    letter-spacing: 0.3px;
}
.panel-badge.live { background: #e6f4ea; color: #1e8e3e; }
.chart-wrap {
    position: relative;
    height: 280px;
}
.legend-list {
    list-style: none; padding: 0; margin: 8px 0 0;
}
.legend-list li {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 0; border-bottom: 1px solid var(--border);
    font-size: 11.5px; color: var(--text2);
}
.legend-list li:last-child { border-bottom: none; }
.legend-dot {
    width: 8px; height: 8px; border-radius: 50%;
    display: inline-block; margin-right: 8px; flex-shrink: 0;
}
.legend-pct { font-weight: 600; color: var(--text); }

/* ── 3-Column Info Row (Recent, Pending, Quick Actions) ── */
.info-row {
    display: grid;
    grid-template-columns: 1fr 1fr 0.8fr;
    gap: 14px;
    margin-top: 16px;
    margin-bottom: 16px;
}
.info-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 16px 18px;
    box-shadow: var(--shadow-md);
    min-height: 200px;
    display: flex;
    flex-direction: column;
}
.info-panel-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 12px;
}
.info-panel-head h3 {
    font-size: 13.5px; font-weight: 600; color: var(--text);
    display: flex; align-items: center; gap: 8px;
}
.info-panel-head h3 i { font-size: 13px; }
.info-panel-head .view-all {
    font-size: 11px; color: var(--gold2); text-decoration: none; font-weight: 600;
    cursor: pointer;
}
.info-panel-head .view-all:hover { text-decoration: underline; }

.info-list {
    list-style: none; flex: 1; overflow-y: auto;
}
.info-list li {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px;
}
.info-list li:last-child { border-bottom: none; }
.info-list .il-name { color: var(--text); font-weight: 500; }
.info-list .il-sub { color: var(--text3); font-size: 10.5px; }
.info-list .il-amt { font-weight: 600; color: var(--text); white-space: nowrap; }
.info-list .il-amt.negative { color: var(--ruby); }

.info-empty {
    flex: 1; display: flex; align-items: center; justify-content: center;
    color: var(--text3); font-size: 12px;
}

/* Quick Action Buttons */
.qa-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px; flex: 1;
}
.qa-btn {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 6px; padding: 14px 8px;
    border: 1px solid var(--border); border-radius: var(--r);
    background: var(--surface); cursor: pointer;
    transition: all 0.15s; font-family: inherit;
}
.qa-btn:hover {
    background: var(--gold-glow); border-color: var(--gold2);
    box-shadow: 0 2px 8px rgba(0,92,187,0.08);
}
.qa-btn i { font-size: 18px; }
.qa-btn span { font-size: 10.5px; font-weight: 600; color: var(--text2); }
.qa-btn.blue i  { color: #1a73e8; }
.qa-btn.green i { color: #1e8e3e; }
.qa-btn.orange i{ color: #e8710a; }
.qa-btn.coral i { color: #e53935; }
.qa-btn.purple i{ color: #7b1fa2; }
.qa-btn.teal i  { color: #00897b; }

/* ── Financial Summary Section ── */
.fin-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 20px 24px;
    box-shadow: var(--shadow-md);
    margin-top: 16px;
}
.fin-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px;
}
.fin-head h2 {
    font-size: 16px; font-weight: 700; color: var(--text);
    font-family: 'Playfair Display', serif;
}
.fin-head h2 span { color: var(--gold2); }
.fin-badges {
    display: flex; gap: 6px;
}
.fin-badge {
    font-size: 11px; padding: 4px 14px; border-radius: 6px;
    border: 1px solid var(--border); background: var(--surface);
    color: var(--text2); font-weight: 600; cursor: pointer; font-family: inherit;
}
.fin-badge.active {
    background: var(--gold); color: #fff; border-color: var(--gold);
}

.fin-tabs {
    display: flex; gap: 0; border-bottom: 2px solid var(--border);
    margin-bottom: 14px; overflow-x: auto;
}
.fin-tab {
    padding: 8px 18px; font-size: 12px; font-weight: 500; color: var(--text3);
    cursor: pointer; border-bottom: 2px solid transparent;
    margin-bottom: -2px; white-space: nowrap; background: none; border-top: none;
    border-left: none; border-right: none; font-family: inherit;
    transition: all 0.15s;
}
.fin-tab:hover { color: var(--text); }
.fin-tab.active {
    color: var(--text); font-weight: 600;
    border-bottom-color: var(--gold);
}

.fin-table {
    width: 100%; border-collapse: collapse; font-size: 12.5px;
}
.fin-table th {
    text-align: right; padding: 10px 12px; font-weight: 600;
    color: var(--text); border-bottom: 2px solid var(--border);
    background: var(--surface2);
}
.fin-table th:first-child { text-align: left; }
.fin-table td {
    padding: 10px 12px; text-align: right;
    border-bottom: 1px solid var(--border); color: var(--text2);
}
.fin-table td:first-child { text-align: left; color: var(--text); font-weight: 500; }
.fin-table tr.section-head td {
    font-weight: 700; color: var(--text); background: var(--surface2);
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
}
.fin-table tr.subtotal td { font-weight: 700; color: var(--text); }
.fin-table .positive { color: #1e8e3e; font-weight: 600; }
.fin-table .negative { color: #e53935; font-weight: 600; }

.fin-panel { display: none; }
.fin-panel.active { display: block; }

.top-items {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}

.top-items th,
.top-items td {
    text-align: left;
    border-bottom: 1px solid var(--border);
    padding: 8px 6px;
}

.top-items th {
    color: var(--text3);
    font-weight: 600;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.top-items td {
    color: var(--text2);
}

.top-items tr:hover td {
    background: var(--surface3);
    color: var(--text);
}

/* ════════════════════════════════════════
   POPUP / WINDOW (MDI legacy windows)
════════════════════════════════════════ */
.window {
    position: absolute;
    width: 900px;
    height: 580px;
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: var(--r);
    box-shadow: var(--shadow-lg);
    display: none;
    overflow: hidden;
    min-width: 300px;
    min-height: 200px;
    transition: box-shadow 0.2s;
}

.window.active {
    display: block;
    border-color: rgba(0,92,187,0.25);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(0,92,187,0.1);
}

.window-header {
    height: 34px;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    cursor: move;
    user-select: none;
}

.window-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.2px;
}

.window-title i { color: var(--gold); }

.controls {
    display: inline-flex;
    gap: 4px;
}

.wbtn {
    width: 22px;
    height: 22px;
    border: 1px solid var(--border);
    cursor: pointer;
    border-radius: var(--r-sm);
    color: var(--text3);
    background: var(--surface2);
    font-size: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
}

.wbtn:hover {
    background: var(--surface3);
    color: var(--text);
    border-color: var(--border2);
}

/* Close button red hover */
.wbtn:nth-child(1) { } /* minimize */
.wbtn:nth-child(2) { } /* maximize */
.wbtn:nth-child(3):hover { background: var(--ruby); color: #fff; border-color: var(--ruby); }

.window-content {
    height: calc(100% - 34px);
    background: var(--surface);
    overflow: auto;
    padding: 16px;
}

.module-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 16px;
}

.module-card h3 {
    margin-bottom: 8px;
    font-size: 18px;
    font-family: 'Playfair Display', serif;
    color: var(--gold2);
}

.module-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
}

.module-tile {
    background: var(--surface2);
    color: var(--text2);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 12px;
    transition: all 0.15s;
}

.module-tile:hover {
    border-color: var(--border2);
    background: var(--surface3);
}

.module-tile h4 {
    font-size: 14px;
    margin-bottom: 6px;
    color: var(--gold);
}

.module-tile p {
    font-size: 12px;
    color: var(--text2);
    line-height: 1.4;
}

.window-toolbar {
    height: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
    border-bottom: 1px solid var(--border);
    background: var(--surface2);
    font-size: 13px;
    color: var(--text2);
}

.window-toolbar i {
    color: var(--gold);
}

.window-url {
    margin-left: auto;
    font-size: 11px;
    color: var(--sapphire);
    background: rgba(135,84,236,0.06);
    border: 1px solid rgba(135,84,236,0.18);
    padding: 2px 8px;
    border-radius: 999px;
    max-width: 48%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.module-iframe {
    width: 100%;
    height: calc(100% - 30px);
    border: 0;
    background: var(--surface);
}

/* ════════════════════════════════════════
   MODULE FRAME SCREEN (full-size iframe overlay)
════════════════════════════════════════ */
.module-frame-screen {
    position: absolute;
    inset: 0;
    display: none;
    background: var(--bg);
    z-index: 2000;
}


.module-frame-head {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    color: var(--text2);
    font-size: 13px;
}

.module-frame-title {
    font-weight: 700;
    color: var(--text);
}

.module-frame-path {
    margin-left: auto;
    font-size: 11px;
    color: var(--sapphire);
    background: rgba(135,84,236,0.06);
    border: 1px solid rgba(135,84,236,0.18);
    padding: 2px 8px;
    border-radius: 999px;
    max-width: 55%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.module-frame-close {
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--border2);
    background: var(--surface3);
    color: var(--text2);
    border-radius: var(--r-sm);
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.12s;
}

.module-frame-close:hover {
    background: var(--ruby);
    color: #fff;
    border-color: var(--ruby);
}

.module-frame-iframe {
    width: 100%;
    height: calc(100% - 36px);
    border: 0;
    background: var(--surface);
}

/* ════════════════════════════════════════
   FORM SHELLS (for inline module content)
════════════════════════════════════════ */
.form-shell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 14px;
}

.form-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.form-title {
    font-size: 20px;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
    color: var(--gold2);
}

.form-type-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--emerald);
    background: rgba(112,199,72,0.1);
    border: 1px solid rgba(112,199,72,0.25);
    border-radius: 999px;
    padding: 4px 10px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(260px, 1fr));
    gap: 10px 12px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.field.span-2 {
    grid-column: span 2;
}

.field.checkline {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-height: 34px;
}

.field.checkline input[type="checkbox"] {
    width: 16px;
    min-height: 16px;
    height: 16px;
    padding: 0;
}

.field label {
    font-size: 10.5px;
    color: var(--text3);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.7px;
}

.field input,
.field select,
.field textarea {
    width: 100%;
    min-height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 7px 10px;
    background: var(--bg2);
    font-size: 13px;
    color: var(--text);
    font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(0,92,187,0.10);
}

.field textarea {
    min-height: 70px;
    resize: vertical;
}

.form-status {
    margin-top: 10px;
    padding: 8px 10px;
    border-radius: var(--r-sm);
    font-size: 12px;
    display: none;
}

.form-status.show { display: block; }

.form-status.ok {
    background: rgba(112,199,72,0.1);
    color: var(--emerald);
    border: 1px solid rgba(112,199,72,0.25);
}

.form-status.err {
    background: rgba(239,68,68,0.08);
    color: var(--ruby);
    border: 1px solid rgba(239,68,68,0.2);
}

.form-actions {
    margin-top: 12px;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
}

.form-actions button {
    min-width: 82px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface2);
    color: var(--text2);
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.12s;
}

.form-actions button:hover {
    background: var(--surface3);
    color: var(--text);
}

.form-actions button.primary {
    border-color: transparent;
    background: var(--gold);
    color: #ffffff;
}

.form-actions button.primary:hover {
    filter: brightness(1.1);
}

.form-actions button.warn {
    border-color: rgba(239,68,68,0.3);
    background: rgba(239,68,68,0.06);
    color: var(--ruby);
}

/* Legacy Customer Shell */
.legacy-customer-shell {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 10px;
    color: var(--text);
}

.legacy-customer-title {
    text-align: center;
    color: var(--ruby);
    text-decoration: underline;
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 8px;
}

.legacy-customer-grid {
    display: grid;
    grid-template-columns: 66px 170px 72px 170px 130px;
    gap: 6px 10px;
    align-items: center;
}

.legacy-customer-grid .lbl {
    font-size: 12px;
    font-weight: 600;
    color: var(--text2);
}

.legacy-customer-grid input,
.legacy-customer-grid select,
.legacy-customer-grid textarea {
    width: 100%;
    min-height: 24px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--text);
    font-size: 12px;
    padding: 3px 6px;
    border-radius: 3px;
}

.legacy-customer-grid textarea {
    min-height: 48px;
    resize: vertical;
}

.legacy-right-panel {
    grid-row: 1 / span 7;
    border: 1px dashed var(--border2);
    min-height: 150px;
    background: var(--surface3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--text3);
    border-radius: var(--r-sm);
}

.legacy-checks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    font-size: 12px;
}

.legacy-checks label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text2);
}

/* ════════════════════════════════════════
   STATUS BAR (row 5)
════════════════════════════════════════ */
.status-bar {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 11.5px;
    color: var(--text3);
}

.status-bar > span,
.sb-seg {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    border-right: 1px solid var(--border);
    height: 100%;
    white-space: nowrap;
}

.sb-seg i { font-size: 10px; }

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--emerald);
    box-shadow: 0 0 4px rgba(112,199,72,0.5);
    flex-shrink: 0;
    display: inline-block;
}

.status-right {
    margin-left: auto;
    border-right: none !important;
}

/* ════════════════════════════════════════
   ANIMATIONS
════════════════════════════════════════ */
@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(0.985); }
}

@keyframes fadeDown {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
}

@keyframes fadeRight {
    from { opacity: 0; transform: translateX(-4px); }
    to { opacity: 1; transform: none; }
}


@keyframes pulse-gold {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
}

/* ════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════ */
@media (max-width: 980px) {
    .app { grid-template-rows: 36px 38px 42px 1fr 30px; }
    .window { width: calc(100% - 16px); height: calc(100% - 16px); left: 8px !important; top: 8px !important; }
    .company-title { font-size: 11px; }
    .top-left { gap: 8px; }
    .summary-cards { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .rate-cards { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .rate-card-value { font-size: 18px; }
    .kpis { grid-template-columns: repeat(2, minmax(140px, 1fr)); }
    .analytics-grid { grid-template-columns: 1fr; }
    .chart-wrap { height: 230px; }
    .toolbar .tb-kbd { display: none; }
    .info-row { grid-template-columns: 1fr; gap: 10px; }
    .qa-grid { grid-template-columns: repeat(3, 1fr); }
    .fin-section { padding: 14px 12px; }
    .fin-table { font-size: 11px; }
    .fin-table th, .fin-table td { padding: 8px 6px; }
    .fin-tabs { gap: 0; }
    .fin-tab { padding: 6px 12px; font-size: 11px; }
}
    </style>
