        <span class="sb-seg"><i class="fas fa-calendar"></i> <span id="statusDate">{{ date('d M Y') }}</span></span>
        <span class="sb-seg"><i class="fas fa-clock"></i> <span id="statusTime">{{ date('h:i A') }}</span></span>
        <span class="sb-seg status-right"><i class="fas fa-code-branch"></i> v2.0</span>
    </div>

</div>

