<script>
(function(){
    'use strict';

    var DS = {
        labels7d:     {!! json_encode($dashboardData['labels'] ?? []) !!},
        sales7d:      {!! json_encode($dashboardData['salesSeries'] ?? []) !!},
        purch7d:      {!! json_encode($dashboardData['purchaseSeries'] ?? []) !!},
        monthLabels:  {!! json_encode($dashboardData['monthLabels'] ?? []) !!},
        monthlySales: {!! json_encode($dashboardData['monthlySalesSeries'] ?? []) !!},
        monthlyPurch: {!! json_encode($dashboardData['monthlyPurchaseSeries'] ?? []) !!},
        topNames:     {!! json_encode(collect($dashboardData['topItems'] ?? [])->pluck('item_name')->toArray()) !!},
        topAmts:      {!! json_encode(collect($dashboardData['topItems'] ?? [])->pluck('total_amount')->toArray()) !!},
        yearlyLabels: {!! json_encode(collect($dashboardData['yearlyFinancials'] ?? [])->pluck('year')->toArray()) !!},
        yearlySales:  {!! json_encode(collect($dashboardData['yearlyFinancials'] ?? [])->pluck('sales')->toArray()) !!},
        yearlyPurch:  {!! json_encode(collect($dashboardData['yearlyFinancials'] ?? [])->pluck('purchases')->toArray()) !!},
        itemColors:   ['#005cbb','#70c748','#ef4444','#f59e0b','#8754ec'],
    };

    /* Sales/Purchase Chart */
    var mainChart = null;
    var currentMode = '6m';

    function buildMainChart(mode) {
        var ctx = document.getElementById('salesChart');
        if (!ctx || typeof Chart === 'undefined') return;
        if (mainChart) { mainChart.destroy(); mainChart = null; }
        var labels = mode === '7d' ? DS.labels7d : DS.monthLabels;
        var sales  = mode === '7d' ? DS.sales7d  : DS.monthlySales;
        var purch  = mode === '7d' ? DS.purch7d  : DS.monthlyPurch;
        var g1 = ctx.getContext('2d').createLinearGradient(0,0,0,260);
        g1.addColorStop(0,'rgba(0,92,187,0.18)'); g1.addColorStop(1,'rgba(0,92,187,0.01)');
        var g2 = ctx.getContext('2d').createLinearGradient(0,0,0,260);
        g2.addColorStop(0,'rgba(112,199,72,0.18)'); g2.addColorStop(1,'rgba(112,199,72,0.01)');
        mainChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label:'Sales', data:sales, borderColor:'#005cbb', backgroundColor:g1, fill:true, tension:0.4, borderWidth:2, pointRadius:3, pointBackgroundColor:'#005cbb' },
                    { label:'Purchase', data:purch, borderColor:'#70c748', backgroundColor:g2, fill:true, tension:0.4, borderWidth:2, pointRadius:3, pointBackgroundColor:'#70c748' }
                ]
            },
            options: {
                responsive:true, maintainAspectRatio:false,
                plugins:{ legend:{position:'top',labels:{font:{size:11},boxWidth:10,padding:12}}, tooltip:{mode:'index',intersect:false} },
                scales:{
                    x:{grid:{display:false},ticks:{font:{size:10},maxTicksLimit:8}},
                    y:{grid:{color:'#ecedf2'},ticks:{font:{size:10},callback:function(v){return '\u20B9'+Number(v).toLocaleString('en-IN');}}}
                }
            }
        });
    }

    window.switchChart = function(mode) {
        currentMode = mode;
        document.getElementById('btn7d').classList.toggle('active', mode==='7d');
        document.getElementById('btn6m').classList.toggle('active', mode==='6m');
        buildMainChart(mode);
    };

    /* Items Donut */
    function buildItemsChart() {
        var ctx = document.getElementById('itemsChart');
        if (!ctx || typeof Chart === 'undefined' || !DS.topNames.length) return;
        new Chart(ctx, {
            type: 'doughnut',
            data: { labels:DS.topNames, datasets:[{data:DS.topAmts,backgroundColor:DS.itemColors,borderWidth:2,borderColor:'#fff',hoverOffset:6}] },
            options: {
                responsive:true, maintainAspectRatio:false, cutout:'60%',
                plugins:{ legend:{display:false}, tooltip:{callbacks:{label:function(c){return c.label+': \u20B9'+Number(c.raw).toLocaleString('en-IN');}}} }
            }
        });
    }

    /* Yearly Chart */
    function buildYearlyChart() {
        var ctx = document.getElementById('yearlyChart');
        if (!ctx || typeof Chart === 'undefined' || !DS.yearlyLabels.length) return;
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: DS.yearlyLabels,
                datasets: [
                    { label:'Sales', data:DS.yearlySales, backgroundColor:'rgba(0,92,187,0.75)', borderRadius:4, borderSkipped:false },
                    { label:'Purchase', data:DS.yearlyPurch, backgroundColor:'rgba(112,199,72,0.65)', borderRadius:4, borderSkipped:false }
                ]
            },
            options: {
                responsive:true, maintainAspectRatio:false,
                plugins:{ legend:{position:'top',labels:{font:{size:11},boxWidth:10,padding:12}}, tooltip:{mode:'index',intersect:false} },
                scales:{
                    x:{grid:{display:false},ticks:{font:{size:10}}},
                    y:{grid:{color:'#ecedf2'},ticks:{font:{size:10},callback:function(v){return '\u20B9'+Number(v).toLocaleString('en-IN');}}}
                }
            }
        });
    }

    /* Financial Tabs */
    window.finTab = function(btn, panelId) {
        document.querySelectorAll('#logoScreen .fin-badge').forEach(function(b){b.classList.remove('active');});
        document.querySelectorAll('#logoScreen .fin-panel').forEach(function(p){p.classList.remove('active');});
        btn.classList.add('active');
        var p = document.getElementById(panelId);
        if (p) p.classList.add('active');
        if (panelId === 'finChart') buildYearlyChart();
    };

    function init() {
        if (typeof Chart !== 'undefined') {
            Chart.defaults.font.family = "'Plus Jakarta Sans','Segoe UI',sans-serif";
            Chart.defaults.font.size = 11;
        }
        buildMainChart('6m');
        buildItemsChart();
    }

    if (typeof Chart !== 'undefined') init();
    else {
        document.addEventListener('DOMContentLoaded', init);
        var poll = setInterval(function(){if(typeof Chart!=='undefined'){clearInterval(poll);init();}},100);
    }
})();
</script>

