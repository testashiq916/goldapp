# SuperGold (Django) — reuses the same MySQL/MariaDB database as the
# original Laravel app. Variable names match the Laravel .env for
# consistency; point both apps at the same DB when migrating gradually.
APP_DEBUG=true
APP_KEY=change-me-in-production
ALLOWED_HOSTS=*

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goldapp
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=120
